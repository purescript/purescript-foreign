{
  "private": true,
  "scripts": {
    "build": "spago build -p foreign",
    "test": "spago build -p foreign-examples",
    "lint": "oxlint --deny-warnings src examples/src",
    "format": "purs-tidy format-in-place src examples/src && oxfmt --write .",
    "format:check": "purs-tidy check src examples/src && oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.5"
  }
}
